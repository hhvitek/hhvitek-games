{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/tools/hooks/after-edit.js\"" }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/tools/hooks/before-stop.js\"" }]
      }
    ]
  },
  "enabledPlugins": {
    "playwright@claude-plugins-official": false,
    "code-review@claude-plugins-official": false,
    "context7@claude-plugins-official": false,
    "security-guidance@claude-plugins-official": false
  }
}
